<!-- ===== DriverX AI Chat Widget (Home-Style) - Start ===== -->
<style>
  #dxh-toggle {
    position: fixed; bottom: 24px; left: 24px; z-index: 999998;
    background: #15803d; color: #fff; border: none; border-radius: 30px;
    display: flex; align-items: center; gap: 8px; padding: 10px 18px 10px 10px;
    cursor: pointer; box-shadow: 0 4px 14px rgba(0,0,0,0.25);
    font-family: -apple-system, BlinkMacSystemFont, 'Segoe UI', Roboto, sans-serif;
    transition: transform 0.2s ease;
  }
  #dxh-toggle:hover { transform: scale(1.04); }
  #dxh-toggle-avatar {
    width: 30px; height: 30px; border-radius: 50%; background: #22c55e;
    display: flex; align-items: center; justify-content: center;
    font-weight: 800; font-size: 14px; color: #fff; flex-shrink: 0;
  }
  #dxh-toggle-text { font-weight: 700; font-size: 14px; }

  #dxh-window {
    position: fixed; bottom: 96px; left: 24px; width: 390px; max-width: 92vw;
    height: 600px; max-height: 82vh; background: #f7faf8; border-radius: 18px;
    box-shadow: 0 12px 44px rgba(0,0,0,0.28); display: none; flex-direction: column;
    overflow: hidden; z-index: 999999;
    font-family: -apple-system, BlinkMacSystemFont, 'Segoe UI', Roboto, sans-serif;
  }
  #dxh-window.dxh-open { display: flex; }

  #dxh-header { background: linear-gradient(160deg,#15803d,#14532d); color: #fff; padding: 16px 18px 14px 18px; flex-shrink: 0; }
  #dxh-header-top { display: flex; align-items: center; gap: 10px; margin-bottom: 4px; }
  #dxh-back { display: none; background: none; border: none; color: #fff; font-size: 18px; cursor: pointer; padding: 2px 4px 2px 0; }
  #dxh-title { font-weight: 800; font-size: 15px; letter-spacing: 0.2px; flex: 1; }
  #dxh-title .dxh-x { color: #86efac; }
  .dxh-header-actions { display: flex; gap: 10px; align-items: center; }
  .dxh-header-actions button { background: none; border: none; color: #d1fae5; font-size: 16px; cursor: pointer; padding: 2px 4px; }
  .dxh-header-actions button:hover { color: #fff; }

  #dxh-greeting { margin: 10px 0 14px 0; }
  #dxh-greeting-title { font-size: 20px; font-weight: 800; line-height: 1.25; margin-bottom: 6px; }
  #dxh-greeting-sub { font-size: 12.5px; color: #d1fae5; line-height: 1.4; }

  #dxh-stepper {
    display: flex; align-items: center; background: rgba(255,255,255,0.12);
    border-radius: 24px; padding: 4px; gap: 2px;
  }
  .dxh-step {
    flex: 1; display: flex; align-items: center; justify-content: center; gap: 5px;
    padding: 7px 6px; border-radius: 20px; font-size: 11px; font-weight: 700; color: #d1fae5;
    transition: background 0.2s ease, color 0.2s ease;
  }
  .dxh-step-icon { width: 16px; height: 16px; border-radius: 50%; background: rgba(255,255,255,0.25); display: flex; align-items: center; justify-content: center; font-size: 9px; flex-shrink: 0; }
  .dxh-step.dxh-step-active { background: #ffffff; color: #14532d; }
  .dxh-step.dxh-step-active .dxh-step-icon { background: #14532d; color: #fff; }
  .dxh-step.dxh-step-done .dxh-step-icon { background: #22c55e; color: #fff; }
  .dxh-step-label { display: none; }
  @media (min-width: 340px) { .dxh-step-label { display: inline; } }

  #dxh-body { flex: 1; overflow-y: auto; padding: 16px; background: #f7faf8; }

  #dxh-home-content { display: flex; flex-direction: column; gap: 14px; }
  #dxh-grid { display: grid; grid-template-columns: 1fr 1fr; gap: 10px; }
  .dxh-grid-card {
    background: #fff; border: 1px solid #e5e7eb; border-radius: 14px; padding: 12px;
    text-align: left; cursor: pointer; font-size: 12.5px; font-weight: 600; color: #111;
    display: flex; flex-direction: column; gap: 8px; font-family: inherit; line-height: 1.3;
    transition: border-color 0.15s ease, box-shadow 0.15s ease;
  }
  .dxh-grid-card:hover { border-color: #16a34a; box-shadow: 0 2px 10px rgba(22,163,74,0.12); }
  .dxh-grid-icon {
    width: 26px; height: 26px; border-radius: 8px; background: #dcfce7; color: #15803d;
    display: flex; align-items: center; justify-content: center; font-size: 14px;
  }

  #dxh-area-box { background: #fff; border: 1px solid #e5e7eb; border-radius: 14px; padding: 14px; }
  #dxh-area-label { font-size: 13px; font-weight: 700; color: #111; margin-bottom: 4px; }
  #dxh-area-examples { font-size: 11.5px; color: #6b7280; margin-bottom: 10px; }
  .dxh-area-city { color: #16a34a; cursor: pointer; text-decoration: underline; font-weight: 600; }
  #dxh-area-inputrow { display: flex; gap: 8px; }
  #dxh-postal { flex: 1; min-width: 0; border: 1px solid #e5e7eb; border-radius: 10px; padding: 9px 11px; font-size: 13px; outline: none; }
  #dxh-postal:focus { border-color: #16a34a; }
  #dxh-postal-check { background: #111; color: #fff; border: none; border-radius: 10px; padding: 9px 16px; font-size: 13px; font-weight: 700; cursor: pointer; white-space: nowrap; }

  #dxh-messages { display: none; flex-direction: column; gap: 10px; }
  #dxh-window.dxh-chat-mode #dxh-home-content { display: none; }
  #dxh-window.dxh-chat-mode #dxh-messages { display: flex; }
  #dxh-window.dxh-chat-mode #dxh-greeting { display: none; }
  #dxh-window.dxh-chat-mode #dxh-back { display: inline-block; }

  .dxh-msg { max-width: 88%; padding: 10px 14px; border-radius: 14px; font-size: 13.5px; line-height: 1.45; }
  .dxh-msg-bot { background: #fff; color: #111; align-self: flex-start; border: 1px solid #e5e7eb; border-bottom-left-radius: 4px; }
  .dxh-msg-bot a { color: #16a34a; text-decoration: underline; font-weight: 600; word-break: break-all; }
  .dxh-msg-user { background: #16a34a; color: #fff; align-self: flex-end; border-bottom-right-radius: 4px; }
  .dxh-typing { display: flex; gap: 4px; padding: 12px 14px; }
  .dxh-typing span { width: 6px; height: 6px; border-radius: 50%; background: #9ca3af; animation: dxhBlink 1.2s infinite; }
  .dxh-typing span:nth-child(2) { animation-delay: 0.2s; }
  .dxh-typing span:nth-child(3) { animation-delay: 0.4s; }
  @keyframes dxhBlink { 0%,80%,100% { opacity: 0.3; } 40% { opacity: 1; } }

  .dxh-chips { display: flex; flex-wrap: wrap; gap: 8px; align-self: flex-start; max-width: 100%; }
  .dxh-chip-btn { background: #fff; border: 1.5px solid #16a34a; color: #16a34a; border-radius: 18px; padding: 8px 13px; font-size: 12.5px; cursor: pointer; transition: background 0.15s ease; font-family: inherit; }
  .dxh-chip-btn:hover { background: #f0fdf4; }

  .dxh-notice-card { background: #f0fdf4; border: 1px solid #86efac; border-radius: 12px; padding: 12px 14px; align-self: flex-start; max-width: 92%; }
  .dxh-notice-title { display: flex; align-items: center; gap: 6px; font-weight: 700; font-size: 13px; color: #15803d; margin-bottom: 4px; }
  .dxh-notice-text { font-size: 12.5px; color: #166534; }

  .dxh-info-card { background: #fff; border: 1px solid #e5e7eb; border-radius: 12px; padding: 12px 14px; align-self: flex-start; max-width: 92%; }
  .dxh-info-title { font-weight: 700; font-size: 12.5px; color: #111; margin-bottom: 4px; }
  .dxh-info-line { font-size: 12.5px; color: #374151; padding: 1px 0; }

  .dxh-card { background: #fff; border: 1.5px solid #16a34a; border-radius: 14px; padding: 14px; align-self: flex-start; max-width: 92%; }
  .dxh-card-label { font-size: 10.5px; font-weight: 700; color: #16a34a; text-transform: uppercase; letter-spacing: 0.4px; margin-bottom: 4px; }
  .dxh-card-title { font-weight: 700; font-size: 13.5px; color: #111; margin-bottom: 6px; }
  .dxh-card-price { display: flex; align-items: center; gap: 8px; margin-bottom: 8px; flex-wrap: wrap; }
  .dxh-card-price .dxh-price-new { font-size: 19px; font-weight: 800; color: #111; }
  .dxh-card-price .dxh-price-old { font-size: 12.5px; color: #9ca3af; text-decoration: line-through; }
  .dxh-card-price .dxh-price-badge { background: #dcfce7; color: #16a34a; font-size: 10.5px; font-weight: 600; padding: 2px 8px; border-radius: 10px; }
  .dxh-card-features { list-style: none; padding: 0; margin: 0 0 12px 0; font-size: 12.5px; color: #374151; }
  .dxh-card-features li { padding: 2px 0; }
  .dxh-card-actions { display: flex; gap: 8px; flex-wrap: wrap; }
  .dxh-btn-primary { background: #16a34a; color: #fff; border: none; border-radius: 20px; padding: 9px 16px; font-size: 12.5px; font-weight: 700; cursor: pointer; text-decoration: none; display: inline-block; }
  .dxh-btn-secondary { background: #fff; color: #111; border: 1.5px solid #d1d5db; border-radius: 20px; padding: 9px 16px; font-size: 12.5px; font-weight: 700; cursor: pointer; text-decoration: none; display: inline-block; }

  .dxh-human-card { background: #fff; border: 1px solid #e5e7eb; border-radius: 14px; padding: 14px; align-self: flex-start; max-width: 92%; }
  .dxh-human-title { font-weight: 700; font-size: 13.5px; margin-bottom: 6px; color: #111; }
  .dxh-human-list { list-style: none; padding: 0; margin: 0 0 12px 0; font-size: 12.5px; color: #374151; }
  .dxh-human-list li { padding: 2px 0; }

  #dxh-inputbar { display: flex; align-items: center; padding: 10px 14px; border-top: 1px solid #e5e7eb; background: #fff; gap: 8px; box-sizing: border-box; flex-shrink: 0; }
  #dxh-input { flex: 1; min-width: 0; border: 1px solid #e5e7eb !important; border-radius: 20px !important; padding: 9px 14px !important; font-size: 13px !important; outline: none !important; box-shadow: none !important; margin: 0 !important; height: auto !important; }
  #dxh-input:focus { border-color: #16a34a !important; }
  #dxh-send { background: #16a34a !important; border: none !important; width: 40px !important; height: 40px !important; min-width: 40px !important; max-width: 40px !important; border-radius: 50% !important; cursor: pointer; display: inline-flex !important; align-items: center !important; justify-content: center !important; flex-shrink: 0 !important; padding: 0 !important; margin: 0 !important; box-sizing: border-box !important; }
  #dxh-send svg { width: 17px; height: 17px; fill: #fff; margin-left: 2px; }

  #dxh-footer-note { text-align: center; font-size: 10.5px; color: #9ca3af; padding: 6px 14px 10px 14px; background: #fff; flex-shrink: 0; }

  @media (max-width: 480px) {
    #dxh-window { left: 8px; right: 8px; width: auto; bottom: 84px; height: 78vh; }
    #dxh-toggle { left: 12px; bottom: 16px; }
  }
</style>

<button id="dxh-toggle">
  <span id="dxh-toggle-avatar">X</span>
  <span id="dxh-toggle-text">Ask DriverX</span>
</button>

<div id="dxh-window">
  <div id="dxh-header">
    <div id="dxh-header-top">
      <button id="dxh-back">&#8592;</button>
      <div id="dxh-title">DRIVER<span class="dxh-x">X</span> Assistant</div>
      <div class="dxh-header-actions">
        <button id="dxh-minimize" title="Minimize">&#8722;</button>
        <button id="dxh-close" title="Close">&times;</button>
      </div>
    </div>
    <div id="dxh-greeting">
      <div id="dxh-greeting-title">Hi, where are you on your driving journey?</div>
      <div id="dxh-greeting-sub">I'll match you to the right DriverX lessons, package, or road-test prep.</div>
    </div>
    <div id="dxh-stepper">
      <div class="dxh-step" data-step="g1"><span class="dxh-step-icon">G1</span><span class="dxh-step-label">Knowledge test</span></div>
      <div class="dxh-step" data-step="g2"><span class="dxh-step-icon">G2</span><span class="dxh-step-label">Road test</span></div>
      <div class="dxh-step" data-step="g"><span class="dxh-step-icon">G</span><span class="dxh-step-label">Full licence</span></div>
    </div>
  </div>

  <div id="dxh-body">
    <div id="dxh-home-content">
      <div id="dxh-grid">
        <button class="dxh-grid-card" data-q="I have my G1, what's next?" data-stage="g2"><span class="dxh-grid-icon">&#9989;</span>I have my G1, what's next?</button>
        <button class="dxh-grid-card" data-q="I need to prepare for my G2 or G road test" data-stage="g"><span class="dxh-grid-icon">&#128663;</span>Prepare for my G2 or G road test</button>
        <button class="dxh-grid-card" data-q="Which package is right for me?"><span class="dxh-grid-icon">&#128230;</span>Which package is right for me?</button>
        <button class="dxh-grid-card" data-q="I need a car for my road test"><span class="dxh-grid-icon">&#128664;</span>I need a car for my road test</button>
      </div>
      <div id="dxh-area-box">
        <div id="dxh-area-label">Are we in your area?</div>
        <div id="dxh-area-examples">
          <span class="dxh-area-city">Toronto</span> &middot;
          <span class="dxh-area-city">Mississauga</span> &middot;
          <span class="dxh-area-city">Brampton</span> &middot;
          <span class="dxh-area-city">Hamilton</span> +
        </div>
        <div id="dxh-area-inputrow">
          <input id="dxh-postal" type="text" placeholder="Postal code, e.g. M5V 2T6" />
          <button id="dxh-postal-check">Check</button>
        </div>
      </div>
    </div>
    <div id="dxh-messages"></div>
  </div>

  <div id="dxh-inputbar">
    <input id="dxh-input" type="text" placeholder="Ask anything about lessons, tests or pricing..." />
    <button id="dxh-send"><svg viewBox="0 0 24 24"><path d="M2.01 21L23 12 2.01 3 2 10l15 2-15 2z"/></svg></button>
  </div>
  <div id="dxh-footer-note">AI assistant. For MTO rules, we'll always point you to the official source.</div>
</div>

<script>
(function() {
  var WEBHOOK_URL = 'https://mateenb.app.n8n.cloud/webhook/fa4b425f-a95a-4464-a182-31f67a402329/chat';
  var TEAM_PHONE_DISPLAY = '+1 (289) 293-9760';
  var TEAM_PHONE_TEL = '+12892939760';

  var toggle = document.getElementById('dxh-toggle');
  var win = document.getElementById('dxh-window');
  var closeBtn = document.getElementById('dxh-close');
  var minimizeBtn = document.getElementById('dxh-minimize');
  var backBtn = document.getElementById('dxh-back');
  var messages = document.getElementById('dxh-messages');
  var input = document.getElementById('dxh-input');
  var sendBtn = document.getElementById('dxh-send');
  var gridCards = document.querySelectorAll('.dxh-grid-card');
  var areaCities = document.querySelectorAll('.dxh-area-city');
  var postalInput = document.getElementById('dxh-postal');
  var postalCheck = document.getElementById('dxh-postal-check');

  var sessionId = localStorage.getItem('dxh_chat_session');
  if (!sessionId) {
    sessionId = 'dxh-' + Date.now() + '-' + Math.random().toString(36).substr(2, 9);
    localStorage.setItem('dxh_chat_session', sessionId);
  }

  function openWindow() { win.classList.add('dxh-open'); }
  function closeWindow() { win.classList.remove('dxh-open'); }
  toggle.addEventListener('click', function() { win.classList.toggle('dxh-open'); });
  closeBtn.addEventListener('click', closeWindow);
  minimizeBtn.addEventListener('click', closeWindow);
  backBtn.addEventListener('click', function() { win.classList.remove('dxh-chat-mode'); });

  function setStage(stage) {
    document.querySelectorAll('.dxh-step').forEach(function(el) {
      var s = el.getAttribute('data-step');
      el.classList.remove('dxh-step-active', 'dxh-step-done');
      if (s === stage) el.classList.add('dxh-step-active');
      else if ((stage === 'g2' && s === 'g1') || (stage === 'g' && (s === 'g1' || s === 'g2'))) el.classList.add('dxh-step-done');
    });
  }
  setStage('g1');

  function enterChatMode() { win.classList.add('dxh-chat-mode'); }

  function linkify(text) {
    var escaped = String(text).replace(/&/g, '&amp;').replace(/</g, '&lt;').replace(/>/g, '&gt;');
    var urlRegex = /(https?:\/\/[^\s]+)/g;
    var withLinks = escaped.replace(urlRegex, function(url) {
      var cleanUrl = url.replace(/[.,;!?)]+$/, '');
      return '<a href="' + cleanUrl + '" target="_blank" rel="noopener noreferrer">' + cleanUrl + '</a>';
    });
    return withLinks.replace(/\n/g, '<br>');
  }

  function addMessage(text, type) {
    var div = document.createElement('div');
    div.className = 'dxh-msg dxh-msg-' + type;
    div.innerHTML = linkify(text);
    messages.appendChild(div);
    messages.scrollTop = messages.scrollHeight;
  }

  function clearChips() {
    var el = document.getElementById('dxh-active-chips');
    if (el) el.remove();
  }

  function renderChips(list) {
    clearChips();
    if (!list || !list.length) return;
    var container = document.createElement('div');
    container.className = 'dxh-chips';
    container.id = 'dxh-active-chips';
    list.forEach(function(q) {
      var btn = document.createElement('button');
      btn.className = 'dxh-chip-btn';
      btn.textContent = q;
      btn.addEventListener('click', function() {
        clearChips();
        addMessage(q, 'user');
        if (/talk to a human/i.test(q)) { handleHumanHandoff(); } else { callAI(q); }
      });
      container.appendChild(btn);
    });
    messages.appendChild(container);
    messages.scrollTop = messages.scrollHeight;
  }

  function renderNotice(notice) {
    if (!notice) return;
    var div = document.createElement('div');
    div.className = 'dxh-notice-card';
    div.innerHTML = '<div class="dxh-notice-title">\u2705 ' + (notice.title || '') + '</div><div class="dxh-notice-text">' + (notice.text || '') + '</div>';
    messages.appendChild(div);
    messages.scrollTop = messages.scrollHeight;
  }

  function renderInfo(info) {
    if (!info) return;
    var linesHtml = (info.lines || []).map(function(l) { return '<div class="dxh-info-line">' + l.replace(/</g,'&lt;') + '</div>'; }).join('');
    var div = document.createElement('div');
    div.className = 'dxh-info-card';
    div.innerHTML = (info.title ? '<div class="dxh-info-title">' + info.title + '</div>' : '') + linesHtml;
    messages.appendChild(div);
    messages.scrollTop = messages.scrollHeight;
  }

  function renderPackageCard(pkg) {
    var card = document.createElement('div');
    card.className = 'dxh-card';
    var featuresHtml = (pkg.features || []).map(function(f) { return '<li>\u2713 ' + f.replace(/</g,'&lt;') + '</li>'; }).join('');
    card.innerHTML =
      '<div class="dxh-card-label">Recommended for you</div>' +
      '<div class="dxh-card-title">' + (pkg.title || '') + '</div>' +
      '<div class="dxh-card-price">' +
        '<span class="dxh-price-new">' + (pkg.price || '') + '</span>' +
        (pkg.original_price ? '<span class="dxh-price-old">' + pkg.original_price + '</span>' : '') +
        (pkg.badge ? '<span class="dxh-price-badge">' + pkg.badge + '</span>' : '') +
      '</div>' +
      '<ul class="dxh-card-features">' + featuresHtml + '</ul>' +
      '<div class="dxh-card-actions">' +
        (pkg.book_url ? '<a class="dxh-btn-primary" href="' + pkg.book_url + '" target="_blank" rel="noopener">Book now</a>' : '') +
      '</div>';
    messages.appendChild(card);
    messages.scrollTop = messages.scrollHeight;
  }

  function handleHumanHandoff() {
    addMessage("Of course. Our team answers Mon-Sat, 9 am to 8 pm, and I'll pass along what you've told me so you don't repeat yourself.", 'bot');
    var card = document.createElement('div');
    card.className = 'dxh-human-card';
    card.innerHTML =
      '<div class="dxh-human-title">DriverX team</div>' +
      '<ul class="dxh-human-list"><li>\u2713 Mon-Sat, 9 am to 8 pm</li></ul>' +
      '<div class="dxh-card-actions"><a class="dxh-btn-primary" href="tel:' + TEAM_PHONE_TEL + '">Call ' + TEAM_PHONE_DISPLAY + '</a></div>';
    messages.appendChild(card);
    renderChips(['Back to questions']);
    var backChip = document.querySelector('#dxh-active-chips .dxh-chip-btn');
    if (backChip) { backChip.onclick = function() { clearChips(); }; }
    messages.scrollTop = messages.scrollHeight;
  }

  function showTyping() {
    var div = document.createElement('div');
    div.className = 'dxh-msg dxh-msg-bot dxh-typing';
    div.id = 'dxh-typing-indicator';
    div.innerHTML = '<span></span><span></span><span></span>';
    messages.appendChild(div);
    messages.scrollTop = messages.scrollHeight;
  }
  function hideTyping() {
    var el = document.getElementById('dxh-typing-indicator');
    if (el) el.remove();
  }

  function callAI(text) {
    showTyping();
    fetch(WEBHOOK_URL, {
      method: 'POST',
      headers: { 'Content-Type': 'application/json' },
      body: JSON.stringify({ action: 'sendMessage', sessionId: sessionId, chatInput: text })
    })
    .then(function(res) { return res.json(); })
    .then(function(data) {
      hideTyping();
      var raw = data.output || data.text || data.reply || '';
      var parsed;
      try {
        var cleaned = raw.trim().replace(/^```json/i, '').replace(/^```/,'').replace(/```$/,'').trim();
        parsed = JSON.parse(cleaned);
      } catch (e) {
        parsed = { reply: raw || "Sorry, I couldn't process that. Please try again.", notice: null, info: null, package: null, quick_replies: [] };
      }
      addMessage(parsed.reply, 'bot');
      renderNotice(parsed.notice);
      renderInfo(parsed.info);
      if (parsed.package) renderPackageCard(parsed.package);
      if (parsed.quick_replies && parsed.quick_replies.length) renderChips(parsed.quick_replies);
    })
    .catch(function(err) {
      hideTyping();
      addMessage("Sorry, something went wrong. Please try again in a moment.", 'bot');
      console.error('DriverX Chat Error:', err);
    });
  }

  function startConversation(text, stage) {
    if (!text) return;
    enterChatMode();
    if (stage) setStage(stage);
    clearChips();
    addMessage(text, 'user');
    callAI(text);
  }

  function sendMessage() {
    var text = input.value.trim();
    if (!text) return;
    input.value = '';
    startConversation(text);
  }

  sendBtn.addEventListener('click', sendMessage);
  input.addEventListener('keypress', function(e) { if (e.key === 'Enter') sendMessage(); });

  gridCards.forEach(function(card) {
    card.addEventListener('click', function() {
      startConversation(card.getAttribute('data-q'), card.getAttribute('data-stage'));
    });
  });

  areaCities.forEach(function(el) {
    el.addEventListener('click', function() { startConversation(el.textContent.trim()); });
  });

  postalCheck.addEventListener('click', function() {
    var val = postalInput.value.trim();
    if (!val) return;
    postalInput.value = '';
    startConversation(val);
  });
  postalInput.addEventListener('keypress', function(e) {
    if (e.key === 'Enter') postalCheck.click();
  });
})();
</script>
